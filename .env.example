# Copier en .env (ou laisser `./mailctl init` le faire). Une seule fiche à remplir par client.

# --- Identité (obligatoire)
MAIL_DOMAIN=example.com               # domaine des adresses : user@example.com
MAIL_HOSTNAME=mail.example.com        # FQDN du serveur : cible du MX, de l'enregistrement A et du PTR
POSTMASTER_ADDRESS=postmaster@example.com
TZ=Europe/Paris

# --- Options
ENABLE_CLAMAV=0                       # antivirus : ~1,5 Go de RAM en plus
POSTFIX_MESSAGE_SIZE_LIMIT=26214400   # taille max d'un message, en octets (25 Mo)
DMS_IMAGE_TAG=latest                  # figer une version (ex. 15.1.0) pour une prod vendue
COMPOSE_PROFILES=                     # "webmail" pour ajouter Roundcube (mode Docker nu)
WEBMAIL_PORT=8080                     # port local de Roundcube (mode Docker nu)

# --- Certificat TLS (mode Docker nu), utilisé par `./mailctl cert`
CERT_EMAIL=admin@example.com          # contact Let's Encrypt
CF_API_TOKEN=                         # seulement pour `mailctl cert cloudflare`

# --- Mode Coolify / Dokploy uniquement
ACME_JSON=/data/coolify/proxy/acme.json   # Dokploy : /etc/dokploy/traefik/dynamic/acme.json

# --- Divers
DMS_CONTAINER=mailserver
BACKUP_KEEP=7
