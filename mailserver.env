# Réglages docker-mailserver communs à tous les clients (stack Rspamd moderne).
# Les valeurs propres à un client (hostname, TZ, ClamAV, taille max...) viennent de .env.
# Référence : https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/

# --- Anti-spam / authentification : Rspamd remplace OpenDKIM, OpenDMARC, SPF-policyd, Amavis, SpamAssassin
ENABLE_RSPAMD=1
ENABLE_RSPAMD_REDIS=1
RSPAMD_LEARN=1
RSPAMD_GREYLISTING=0
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_POSTGREY=0
MOVE_SPAM_TO_JUNK=1

# --- Sécurité
ENABLE_FAIL2BAN=1
SPOOF_PROTECTION=1
PERMIT_DOCKER=none
POSTSCREEN_ACTION=enforce
TLS_LEVEL=modern

# --- Services
ENABLE_IMAP=1
ENABLE_POP3=0
ENABLE_QUOTAS=1
ENABLE_SRS=0

# --- Exploitation
LOG_LEVEL=info
LOGROTATE_INTERVAL=weekly
LOGROTATE_COUNT=8
ENABLE_UPDATE_CHECK=0
